# Copy to .env (git-ignored). On the server /opt/finforecast/.env is created once and never committed.
DEBUG=false
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=price-predictions.net,www.price-predictions.net,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://price-predictions.net,https://www.price-predictions.net
SITE_URL=https://price-predictions.net
INDEXING=false
# Non-guessable admin path, ending with "/"
ADMIN_URL=admin/

POSTGRES_DB=finforecast
POSTGRES_USER=finforecast
POSTGRES_PASSWORD=
DATABASE_URL=postgres://finforecast:${POSTGRES_PASSWORD}@db:5432/finforecast
REDIS_URL=redis://redis:6379/0

# Market data (milestone 2). Added by the owner, never committed.
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=
ANTHROPIC_API_KEY=
FINNHUB_API_KEY=
